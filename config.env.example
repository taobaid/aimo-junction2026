# Copy to config.env for LIVE mode only. Never upload config.env.
AIMO_API_KEY=
ANTHROPIC_API_KEY=
RECIPE_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional absolute path. Omit to use the organiser JSON next to the code.
# AIMO_CATALOG=C:\Users\you\Downloads\valio_aimo_junction26_product_data.json
AIMO_CUSTOMER=123
AIMO_APPROVAL_LIMIT=1200
AIMO_RECIPE_MEASUREMENTS=kitchen
AIMO_RECIPE_AUTONOMY=review
AIMO_PLANNING_SECONDS=180
# Voice is optional. Configure your OWN assistant and keys using VOICE_SETUP.md.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
